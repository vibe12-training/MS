# 이 파일을 .env 로 복사한 뒤 값을 채우면 AI 생성이 켜집니다.
# AI_API_KEY 와 AI_MODEL 이 모두 있어야 켜지고, 하나라도 없으면 내장 문제은행으로 동작합니다.

# OpenAI 를 쓸 때
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=발급받은_키
# AI_MODEL=사용할_모델_이름

# Azure AI Foundry(Azure OpenAI) 를 쓸 때
# AI_BASE_URL=https://리소스이름.openai.azure.com/openai/v1
# AI_API_KEY=발급받은_키
# AI_MODEL=배포_이름

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 서버 주소 (기본값: 이 컴퓨터에서만 접속 가능)
# HOST=127.0.0.1
# PORT=3000
